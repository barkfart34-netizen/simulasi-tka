{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simulasi-tka",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simulasi-tka-db",
      "database_id": "b8c9807d-ce01-475e-b6ed-f60d32641900",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "SIMULASI TKA PUSMENDIK CBT"
  }
}
